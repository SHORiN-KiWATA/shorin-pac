post_install() {
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "\e[1;36m  shorin-pac 安装完成！ / shorin-pac installed!\e[0m"
    echo ""
    echo -e "  要直接输入 pac / pacr 运行，请以\e[1;33m普通用户身份\e[0m执行："
    echo -e "  To run pac / pacr directly, run as your \e[1;33mnormal user\e[0m:"
    echo ""
    echo -e "\e[1;33m    shorin-pac link\e[0m"
    echo ""
    echo -e "  配置 AI 供应商 / Configure the AI provider:  \e[1;33mshorin-pac config\e[0m"
    echo -e "  (请确保 ~/.local/bin 已加入 PATH / make sure ~/.local/bin is in PATH)"
    echo -e "\e[1;32m=================================================================\e[0m"
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "shorin-pac: 如曾运行过 shorin-pac link，请手动删除 ~/.local/bin/pac 与 ~/.local/bin/pacr。"
    echo "shorin-pac: if you ran 'shorin-pac link', remove ~/.local/bin/pac and ~/.local/bin/pacr manually."
}
