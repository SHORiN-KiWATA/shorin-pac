# --- 3. 参数解析 ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) SHOW_HELP=true; shift ;;
        --clean) CLEAN_MODE="yes"; shift ;;
        --no-clean) CLEAN_MODE="no"; shift ;;
        --scan) SCAN_ONLY=true; CLEAN_MODE="yes"; shift ;;
        --rm) USE_RM=true; shift ;;
        --ai)
            [[ -n "${2:-}" ]] || { echo "Error: --ai requires <provider[:model]>." >&2; exit 1; }
            AI_SPEC="$2"; shift 2 ;;
        --ai-model)
            [[ -n "${2:-}" ]] || { echo "Error: --ai-model requires a model value." >&2; exit 1; }
            AI_MODEL_OVERRIDE="$2"; shift 2 ;;
        *) QUERY_ARGS+=("$1"); shift ;;
    esac
done

# --- 4. 核心依赖检查与动态 Helper 探测 ---
command -v fzf >/dev/null 2>&1 || { echo "${MSG[ERR_FZF]}" >&2; exit 1; }

AUR_HELPER=""
if command -v paru >/dev/null 2>&1; then
    AUR_HELPER="paru"
elif command -v yay >/dev/null 2>&1; then
    AUR_HELPER="yay"
else
    echo "${MSG[ERR_HELPER]}" >&2
    exit 1
fi

HAS_FLATPAK=false
if command -v flatpak >/dev/null 2>&1; then
    HAS_FLATPAK=true
fi

# --- 5. 帮助信息拦截 ---
