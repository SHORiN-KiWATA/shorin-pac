#!/usr/bin/env bash
# 描述： 卸载软件包TUI，可用 AI 检测并清理家目录残留
# Description: Remove pkgs TUI with optional AI leftover cleanup
# ==============================================================================
# 流程：fzf 多选要卸载的包 → 询问是否用 AI 检测残留 → 收集包元数据（卸载前）→
#       枚举家目录候选 → AI 判断 → fzf 勾选残留 → 确认卸载 → 卸载 → 卸载成功后把勾选项移入回收站
# 安全边界：只动家目录；黑名单路径永不列出；AI 给出的路径必须存在、在家目录内且不在黑名单；
#           默认移入回收站（gio trash > trash-put > 手写 FreeDesktop 规范），--rm 才直接删除。
# ==============================================================================
set -euo pipefail

SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
export SHELL=$(grep -m 1 -E '^/.*/bash$' /etc/shells || echo "/bin/bash")

# --- 1. 隐藏的内部调用：用于双轨并行生成/刷新数据 ---
if [[ "${1:-}" == "--generate-data" ]]; then
    AWK_CMD_PACMAN='
        NR==FNR {
            if (!($2 in repo)) { repo[$2] = $1 }
            next
        }
        {
            pkg_name = $1; pkg_ver = $2
            rname = (pkg_name in repo) ? repo[pkg_name] : "aur"
            color = (pkg_name in repo) ? cb : cp
            printf "PKG: %s%s%s", color, rname, r
            for(i=length(rname); i<16; i++) printf " "
            printf " %-35s %s\n", pkg_name, pkg_ver
        }
    '
    AWK_CMD_FLATPAK='
        {
            if (NF < 3) next
            app_id = $1; origin = $2
            $1=""; $2=""; name=$0
            sub(/^[ \t]+/, "", name); sub(/[ \t]+$/, "", name)
            printf "FLTK: %s%s%s", cc, origin, r
            for(i=length(origin); i<16; i++) printf " "
            printf " %-35s %s\n", name, app_id
        }
    '
    awk -v cb='\033[34m' -v cp='\033[35m' -v r='\033[0m' \
        "$AWK_CMD_PACMAN" <(pacman --color=never -Sl 2>/dev/null || true) <(pacman --color=never -Q)
    if command -v flatpak >/dev/null 2>&1; then
        flatpak list --app --columns=application,origin,name 2>/dev/null | \
        awk -v cc='\033[36m' -v r='\033[0m' "$AWK_CMD_FLATPAK" || true
    fi
    exit 0
fi

# --- 2. 环境与多语言字典配置 ---
ORIGINAL_LANG="${LC_ALL:-${LC_MESSAGES:-${LANG:-C}}}"
if [[ "${ORIGINAL_LANG,,}" == *zh* ]]; then
    IS_CHINESE_LOCALE=true
else
    IS_CHINESE_LOCALE=false
fi
SHOW_HELP=false
QUERY_ARGS=()
CLEAN_MODE="ask"      # ask | yes | no
SCAN_ONLY=false
USE_RM=false
AI_SPEC=""
AI_MODEL_OVERRIDE=""
MAX_CANDIDATES=80
MAX_TOKEN_SEARCH_DEPTH=3

if [[ -r "${SCRIPT_DIR}/../lib/shorin-pac.sh" ]]; then
    AI_LIB="${SCRIPT_DIR}/../lib/shorin-pac.sh"
elif [[ -r /usr/lib/shorin-pac/lib/shorin-pac.sh ]]; then
    AI_LIB="/usr/lib/shorin-pac/lib/shorin-pac.sh"
else
    AI_LIB=""
fi

# `pacr config [...]`：与 pac config 相同
if [[ "${1:-}" == "config" ]]; then
    shift
    [[ -n "$AI_LIB" ]] || { echo "pacr: lib/shorin-pac.sh not found" >&2; exit 1; }
    SHORIN_PAC_LOCALE="$ORIGINAL_LANG"
    # shellcheck source=/dev/null
    source "$AI_LIB"
    config_main "$@"
    exit $?
fi

declare -A MSG
if [[ "$IS_CHINESE_LOCALE" == true ]]; then
    MSG[DESC]="统一模糊搜索并卸载系统软件包 (支持 Pacman/AUR 与 Flatpak)，可用 AI 检测家目录残留并移入回收站。"
    MSG[OPTS]="选项："
    MSG[OPT_HELP]="  --help, -h      显示此帮助信息并退出"
    MSG[OPT_CLEAN]="  --clean         卸载前用 AI 检测残留（不再询问）"
    MSG[OPT_NO_CLEAN]="  --no-clean      跳过残留检测（不再询问）"
    MSG[OPT_SCAN]="  --scan          只检测并列出残留，不卸载、不删除"
    MSG[OPT_RM]="  --rm            残留直接删除，而不是移入回收站"
    MSG[OPT_AI]="  --ai <供应商[:模型]>  本次使用指定的 AI 供应商/模型"
    MSG[OPT_AI_MODEL]="  --ai-model <模型>     只更换当前供应商下的模型"
    MSG[FEAT]="功能特性："
    MSG[FEAT_1]="- 大一统架构：同屏混合显示并多选 Native 包与 Flatpak 应用"
    MSG[FEAT_2]="- 彻底与安全：Pacman 递归删除配置 (-Rns)，Flatpak 原生防误删保护"
