    MSG[DELETED]="已删除："
    MSG[TRASH_FAILED]="处理失败："
    MSG[TRASH_BACKEND]="回收站："
    MSG[DONE]="完成：%s 项已处理"
    MSG[SRC_AI]="AI"
    MSG[SRC_HEURISTIC]="名称匹配"
    MSG[SRC_AI_EXTRA]="AI 自行发现"
    MSG[CONF_HIGH]="高"
    MSG[CONF_MEDIUM]="中"
    MSG[CONF_LOW]="低"
else
    MSG[DESC]="Unified fuzzy search & remove for system packages (Pacman/AUR & Flatpak), with AI leftover detection in HOME and trash."
    MSG[OPTS]="Options:"
