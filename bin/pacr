    MSG[TOKENS]="关键词："
    MSG[CANDIDATES]="候选：%s 项"
    MSG[NO_CANDIDATES]="未在家目录发现相关残留。"
    MSG[AI_FAILED]="AI 检测失败，改为按名称启发式列出残留。"
