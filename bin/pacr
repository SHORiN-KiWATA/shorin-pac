    MSG[PICKED_RM]=">> Leftovers (deleted after a successful removal, %s item(s))"
    MSG[SCAN_DONE]="Scan-only mode: nothing was removed or deleted."
    MSG[CONFIRM_REMOVE]="Continue with removal? [Y/n] "
    MSG[CANCELLED]="Cancelled."
