  ${MSG[DESC]}

${MSG[FEAT]}
  ${MSG[FEAT_1]}
  ${MSG[FEAT_2]}
  ${MSG[FEAT_3]}
  ${MSG[FEAT_4]}

${MSG[EX]}
  ${0##*/} firefox        # 搜索并卸载 'firefox' (无缝跨越两端)
  ${0##*/} --scan qq      # 只看看 qq 在家目录留了什么
  ${0##*/}                # 列出所有已安装的包
EOF
    exit 0
fi

# --- 6. 文件安全设置 ---
TMP_DIR=$(mktemp -d -t shorin-pacr.XXXXXX)
TARGET_FILE="${TMP_DIR}/target"
CLEAN_FLAG="${TMP_DIR}/clean-requested"

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT INT TERM

# ==============================================================================
# 残留检测
# ==============================================================================

# 永不列出、永不删除的家目录路径（相对 $HOME，支持 glob 前缀匹配）
DENYLIST=(
    .ssh .gnupg .pki .password-store .aws .azure .kube .docker .netrc
    .bashrc .bash_profile .bash_logout .bash_history .zshrc .zsh_history .zprofile .zshenv .profile
    .xinitrc .xprofile .Xauthority .ICEauthority .xsession-errors .gitconfig .gtkrc-2.0
    .config/user-dirs.dirs .config/user-dirs.locale .config/mimeapps.list .config/dconf .config/fontconfig
    .config/gtk-3.0 .config/gtk-4.0 .config/qt5ct .config/qt6ct .config/Kvantum .config/systemd .config/environment.d
    .config/pulse .config/pipewire .config/wireplumber .config/dbus-1 .config/shorin-pac .config/fish .config/nvim
    .cache/fontconfig .cache/mesa_shader_cache .cache/mesa_shader_cache_db .cache/radv_builtin_shaders .cache/thumbnails
    .cache/paru .cache/yay .cache/pacman .cache/shorin-pac .cache/pip .cache/go-build .cache/cargo
    .local/share/Trash .local/share/keyrings .local/share/flatpak .local/share/mime .local/share/icons .local/share/fonts
    .local/share/themes .local/share/applications .local/share/systemd .local/share/gvfs-metadata .local/share/pacman
    .local/state/wireplumber .local/bin .local/lib .themes .icons .fonts .var/app .var .local .config .cache .miyu
    Desktop Documents Downloads Music Pictures Videos Public Templates
)

# 通用词：不能作为匹配关键词
GENERIC_TOKENS=" linux arch tool tools client app apps desktop the and for with gnu gtk qt git bin lib libs x86 wine proton official unofficial free open source software program launcher manager viewer player editor plugin plugins theme themes icon icons font fonts data config cache share local state common core base extra community utils util python python3 nodejs node java rust "

is_denied() {
    # is_denied <绝对路径>：在黑名单内或不在家目录内 → 0
    local path="$1" rel entry
    case "$path" in
        "$HOME"/*) rel="${path#"$HOME"/}" ;;
        *) return 0 ;;
    esac
    [[ -n "$rel" ]] || return 0
    for entry in "${DENYLIST[@]}"; do
        if [[ "$rel" == "$entry" || "$rel" == "$entry"/* ]]; then
            # 黑名单目录本身与其内部都拒绝，除了几个允许“内部单个文件”的共享目录
            case "$entry" in
                .local/share/applications|.config|.cache|.local|.var|.var/app|Documents|Downloads|Music|Pictures|Videos|Desktop)
                    [[ "$rel" == "$entry" ]] && return 0
                    ;;
                *) return 0 ;;
            esac
        fi
    done
    return 1
}

add_token() {
    # add_token <词>：规范化后加入 TOKENS（去重、去通用词、长度 ≥ 3）
    local t
    t=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '"' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [[ ${#t} -ge 2 ]] || return 0
    [[ "$GENERIC_TOKENS" != *" $t "* ]] || return 0
    [[ "$t" =~ ^[a-z0-9][a-z0-9._+-]*$ ]] || return 0
    local existing
    for existing in "${TOKENS[@]}"; do
        [[ "$existing" != "$t" ]] || return 0
    done
    TOKENS+=("$t")
}

add_name_tokens() {
    # 一个名字派生出多个关键词：整体、去后缀、按分隔符拆分
    local name="$1" base part
    add_token "$name"
    base=$(printf '%s' "$name" | sed -E 's/-(git|bin|appimage|electron|wayland|qt|gtk|nightly|beta|dev|stable|desktop|app|cli|gui)$//; s/^linux//')
    add_token "$base"
    for part in $(printf '%s' "$name" | tr '._-' '   '); do
        add_token "$part"
    done
}

collect_pacman_meta() {
    # collect_pacman_meta <pkg>：追加一条 package JSON 到 $PKG_META_FILE，并累积 TOKENS
    local pkg="$1" desc url line bins=() desktops=() dname wm file
    # 注意：值里可能含冒号（URL），只按第一个冒号切
    desc=$(pacman -Qi "$pkg" 2>/dev/null | awk '/^(Description|描述)/ { sub(/^[^:]*:[ \t]*/, ""); print; exit }')
    url=$(pacman -Qi "$pkg" 2>/dev/null | awk '/^(URL|网址)/ { sub(/^[^:]*:[ \t]*/, ""); print; exit }')
    add_name_tokens "$pkg"
    while IFS= read -r line; do
        case "$line" in
            /usr/bin/*)
                [[ "$line" == */ ]] && continue
                bins+=("$(basename "$line")")
                add_name_tokens "$(basename "$line")"
                ;;
            /usr/share/applications/*.desktop)
                file="$line"
                dname=$(grep -m1 -E '^Name=' "$file" 2>/dev/null | cut -d= -f2- || true)
                wm=$(grep -m1 -E '^StartupWMClass=' "$file" 2>/dev/null | cut -d= -f2- || true)
                desktops+=("$(jq -cn --arg f "$(basename "$file")" --arg n "$dname" --arg w "$wm" '{file:$f, name:$n, wm_class:$w}')")
                add_name_tokens "$(basename "$file" .desktop)"
                [[ -z "$dname" ]] || add_name_tokens "$dname"
                [[ -z "$wm" ]] || add_name_tokens "$wm"
                ;;
        esac
    done < <(pacman -Qlq "$pkg" 2>/dev/null || true)
    # 上游 URL：二级域名与路径段（github.com/foo/bar → foo、bar）
    if [[ -n "$url" ]]; then
        local host path seg
        host=$(printf '%s' "$url" | sed -E 's#^[a-zA-Z]+://##; s#[/:?].*##; s#^www\.##')
        path=$(printf '%s' "$url" | sed -E 's#^[a-zA-Z]+://[^/]+##')
        case "$host" in
            github.com|gitlab.com|codeberg.org|sourceforge.net|gitee.com|bitbucket.org|*.github.io|*.gitlab.io) ;;
            *)
                # 取可注册域名的二级标签：im.qq.com → qq；foo.co.uk → foo
                local -a labels=()
                IFS='.' read -r -a labels <<< "$host"
                if (( ${#labels[@]} >= 2 )); then
                    local sld="${labels[$(( ${#labels[@]} - 2 ))]}"
                    case "$sld" in
                        co|com|org|net|ac|edu|gov) (( ${#labels[@]} >= 3 )) && sld="${labels[$(( ${#labels[@]} - 3 ))]}" ;;
                    esac
                    add_token "$sld"
                fi
                ;;
        esac
        for seg in $(printf '%s' "$path" | tr '/' ' '); do add_name_tokens "$seg"; done
    fi
    # 描述里的专有名词（首字母大写、≥4 字母）
    for seg in $(printf '%s' "$desc" | tr -c 'A-Za-z0-9' ' '); do
        [[ "$seg" =~ ^[A-Z][A-Za-z0-9]{3,}$ ]] && add_token "$seg"
    done
    jq -cn --arg name "$pkg" --arg desc "$desc" --arg url "$url" \
        --argjson bins "$(printf '%s\n' "${bins[@]:-}" | grep -v '^$' | jq -R . | jq -s .)" \
        --argjson desktops "$(printf '%s\n' "${desktops[@]:-}" | grep -v '^$' | jq -s .)" \
        '{name:$name, kind:"pacman", description:$desc, url:$url, binaries:$bins, desktop:$desktops}' >> "$PKG_META_FILE"
}

collect_flatpak_meta() {
    local appid="$1" name part
    name=$(flatpak info "$appid" 2>/dev/null | awk '/^(Name|名称)/ { sub(/^[^:]*:[ \t]*/, ""); print; exit }' || true)
    add_token "$appid"
    for part in $(printf '%s' "$appid" | tr '.' ' '); do
        case "$part" in com|org|io|net|de|fr|uk|cn|app|github|gitlab|codeberg|sourceforge) ;; *) add_name_tokens "$part" ;; esac
    done
    [[ -z "$name" ]] || add_name_tokens "$name"
    jq -cn --arg name "$appid" --arg desc "$name" \
        '{name:$name, kind:"flatpak", description:$desc, url:"", binaries:[], desktop:[], data_dir:("~/.var/app/" + $name)}' >> "$PKG_META_FILE"
}

path_matches_tokens() {
    # path_matches_tokens <路径> → 打印匹配到的关键词（空格分隔）；无匹配返回 1
    local base t matched=""
    base=$(basename "$1" | tr '[:upper:]' '[:lower:]')
    base="${base%.desktop}"
    for t in "${TOKENS[@]}"; do
        if [[ "$base" == "$t" ]]; then
            matched="${matched:+$matched }$t"
        elif (( ${#t} >= 3 )) && { [[ "$base" == *"$t"* ]] || { (( ${#base} >= 4 )) && [[ "$t" == *"$base"* ]]; }; }; then
            # 短关键词（2 字符）只做整名匹配，避免 "qq" 命中一堆无关目录
            matched="${matched:+$matched }$t"
        fi
    done
    [[ -n "$matched" ]] || return 1
    printf '%s' "$matched"
}

emit_candidate() {
    # emit_candidate <路径> <location> <matched tokens>：写一行 candidate JSON（去重、黑名单、存在性）
    local path="$1" loc="$2" matched="$3" kind bytes mtime
    [[ -e "$path" ]] || return 0
    is_denied "$path" && return 0
    grep -qxF -- "$path" "$SEEN_FILE" 2>/dev/null && return 0
    printf '%s\n' "$path" >> "$SEEN_FILE"
    if [[ -d "$path" ]]; then kind="dir"; else kind="file"; fi
    bytes=$(du -sb -- "$path" 2>/dev/null | cut -f1 || echo 0)
    mtime=$(stat -c '%y' -- "$path" 2>/dev/null | cut -d. -f1 || echo "")
    jq -cn --arg p "$path" --arg k "$kind" --argjson b "${bytes:-0}" --arg m "$mtime" --arg l "$loc" \
        --argjson t "$(printf '%s\n' $matched | jq -R . | jq -s .)" \
        '{path:$p, kind:$k, bytes:$b, mtime:$m, location:$l, matched_tokens:$t}' >> "$CAND_FILE"
}

enumerate_candidates() {
    # 标准位置按“每个应用一个条目”的粒度枚举；再对非隐藏目录做限深的关键词搜索
    local root entry matched name
    for root in .config .cache .local/share .local/state .var/app; do
        [[ -d "$HOME/$root" ]] || continue
        for entry in "$HOME/$root"/* "$HOME/$root"/.[!.]*; do
            [[ -e "$entry" ]] || continue
            if matched=$(path_matches_tokens "$entry"); then
                emit_candidate "$entry" "$root" "$matched"
            fi
        done
    done
    # 共享目录里的单个文件
    for root in .local/share/applications .config/autostart .local/share/icons/hicolor .local/share/pixmaps; do
        [[ -d "$HOME/$root" ]] || continue
        while IFS= read -r entry; do
            if matched=$(path_matches_tokens "$entry"); then
                emit_candidate "$entry" "$root" "$matched"
            fi
        done < <(find "$HOME/$root" -maxdepth 3 -type f 2>/dev/null)
    done
    # 根级点目录/点文件
    for entry in "$HOME"/.[!.]*; do
        [[ -e "$entry" ]] || continue
        name=$(basename "$entry")
        case "$name" in .config|.cache|.local|.var) continue ;; esac
        if matched=$(path_matches_tokens "$entry"); then
            emit_candidate "$entry" "home" "$matched"
        fi
    done
    # 非隐藏目录（Documents、Games…）限深关键词搜索：偏门位置如 ~/Documents/Tencent Files
    local -a find_args=()
    local t
    for t in "${TOKENS[@]}"; do
        if (( ${#t} >= 3 )); then find_args+=(-o -iname "*${t}*"); else find_args+=(-o -iname "${t}"); fi
    done
    [[ ${#find_args[@]} -gt 0 ]] || return 0
    while IFS= read -r entry; do
        if matched=$(path_matches_tokens "$entry"); then
            emit_candidate "$entry" "visible" "$matched"
        fi
    done < <(find "$HOME" -mindepth 2 -maxdepth "$MAX_TOKEN_SEARCH_DEPTH" -not -path "$HOME/.*" \
                \( -false "${find_args[@]}" \) 2>/dev/null | head -n 200)
}

score_candidates() {
    # 给候选打分并按分数排序，截断到 MAX_CANDIDATES；输出 NDJSON 到 $CAND_FILE
    local sorted="${CAND_FILE}.sorted"
    jq -c --argjson toks "$(printf '%s\n' "${TOKENS[@]}" | jq -R . | jq -s .)" '
        . as $c
        | ($c.path | split("/") | last | ascii_downcase | sub("\\.desktop$"; "")) as $base
        | (if ($toks | index($base)) then 100 else 60 end) as $name_score
        | (if ($c.location == ".config" or $c.location == ".local/share" or $c.location == ".var/app") then 20
           elif ($c.location == ".cache" or $c.location == ".local/state") then 10
           elif ($c.location == "home") then 5 else 0 end) as $loc_score
        | . + {score: ($name_score + $loc_score)}
    ' "$CAND_FILE" | jq -s -c 'sort_by(-.score) | .[]' | head -n "$MAX_CANDIDATES" > "$sorted"
    mv -f "$sorted" "$CAND_FILE"
}

load_ai_lib() {
    [[ -n "$AI_LIB" ]] || return 1
    SHORIN_PAC_LOCALE="$ORIGINAL_LANG"
    # shellcheck source=/dev/null
    source "$AI_LIB"
    ai_init || return 1
    local spec="$AI_SPEC"
    if [[ -z "$spec" && -n "$AI_MODEL_OVERRIDE" ]]; then
        ai_resolve >/dev/null 2>&1 || return 1
        spec="${AI_PROVIDER_ID}:${AI_MODEL_OVERRIDE}"
    fi
    ai_resolve "$spec" || return 1
    AI_LOADED=true
}

LEFTOVER_JQ_CHECK='(.leftovers | type == "array")
    and all(.leftovers[]; (.path | type == "string") and (.confidence | IN("high","medium","low")))'

run_leftover_ai() {
    # run_leftover_ai DOSSIER RESULT：调用 AI，结果 JSON 写到 RESULT
    local dossier="$1" result="$2" sys="${TMP_DIR}/leftover.system"
    {
        cat "${AI_PROMPT_DIR}/leftover-scan.md"
        if ai_backend_has_tools; then cat "${AI_PROMPT_DIR}/leftover-scan-tools.md"; fi
        printf '\nLanguage: write `reason` and `notes` in %s.\n' "$(ai_lang_name)"
    } > "$sys"
    echo -e "\033[36m>> AI\033[0m \033[90m$(ai_describe_selection)\033[0m"
    ai_json_complete "$sys" "$dossier" "$result" "$HOME" "$LEFTOVER_JQ_CHECK"
}

build_final_list() {
    # 合并 AI 结果与候选：输出 NDJSON {path, confidence, reason, source, bytes} 到 $FINAL_FILE
    # AI 给的路径必须：存在、在家目录内、不在黑名单、不是别的条目的子路径重复
    local result="$1" line path conf reason bytes src
    : > "$FINAL_FILE"
    if [[ -s "$result" ]]; then
        while IFS= read -r line; do
            path=$(jq -r '.path' <<< "$line")
            path="${path/#\~/$HOME}"
            [[ "$path" == /* ]] || path="$HOME/$path"
            path=$(realpath -m -- "$path" 2>/dev/null || printf '%s' "$path")
            [[ -e "$path" && ! -L "$path" ]] || continue
            is_denied "$path" && continue
            conf=$(jq -r '.confidence' <<< "$line")
            reason=$(jq -r '.reason // ""' <<< "$line" | tr -d '\n\t')
            if grep -qxF -- "$path" "$SEEN_FILE" 2>/dev/null; then src="ai"; else src="ai_extra"; fi
            bytes=$(du -sb -- "$path" 2>/dev/null | cut -f1 || echo 0)
            jq -cn --arg p "$path" --arg c "$conf" --arg r "$reason" --arg s "$src" --argjson b "${bytes:-0}" \
                '{path:$p, confidence:$c, reason:$r, source:$s, bytes:$b}' >> "$FINAL_FILE"
        done < <(jq -c '.leftovers[]' "$result" 2>/dev/null)
    fi
    if [[ "$HEURISTIC_FALLBACK" == true ]]; then
        # 无 AI：候选按名称匹配列出，完全同名算中置信度，其余低
        jq -c 'if .score >= 110 then .confidence = "medium" else .confidence = "low" end
               | {path:.path, confidence:.confidence, reason:("matched: " + (.matched_tokens | join(", "))), source:"heuristic", bytes:.bytes}' \
            "$CAND_FILE" >> "$FINAL_FILE"
    else
        # 有 AI：AI 没提到但与包名完全同名的候选，仍以低置信度列出、不预选，由用户决定（AI 可能漏）
        jq -c 'select(.score >= 100)
               | {path:.path, confidence:"low", reason:("matched: " + (.matched_tokens | join(", "))), source:"heuristic", bytes:.bytes}' \
            "$CAND_FILE" >> "$FINAL_FILE"
    fi
    # 去重 + 去掉被父目录覆盖的子项 + 按置信度排序
    jq -s -c '
        unique_by(.path)
        | . as $all
        | [ .[] | . as $e | select( any($all[]; .path != $e.path and ((.path + "/") as $p | $e.path | startswith($p))) | not ) ]
        | sort_by((if .confidence == "high" then 0 elif .confidence == "medium" then 1 else 2 end), .path)
        | .[]' "$FINAL_FILE" > "${FINAL_FILE}.tmp"
    mv -f "${FINAL_FILE}.tmp" "$FINAL_FILE"
}

human_size() {
    numfmt --to=iec --suffix=B "$1" 2>/dev/null || printf '%sB' "$1"
}

pick_leftovers() {
    # fzf 勾选；输出选中的路径到 $PICK_FILE。高置信度项预选。
    local rows preselect="" n=0 i conf label src_label color
    : > "$PICK_FILE"
    rows=$(while IFS= read -r line; do
        n=$((n + 1))
        conf=$(jq -r '.confidence' <<< "$line")
        case "$conf" in
            high) label="${MSG[CONF_HIGH]}"; color=$'\033[31m'; preselect="${preselect}+pos(${n})+select" ;;
            medium) label="${MSG[CONF_MEDIUM]}"; color=$'\033[33m' ;;
            *) label="${MSG[CONF_LOW]}"; color=$'\033[90m' ;;
        esac
        case "$(jq -r '.source' <<< "$line")" in
            ai) src_label="${MSG[SRC_AI]}" ;;
            ai_extra) src_label="${MSG[SRC_AI_EXTRA]}" ;;
            *) src_label="${MSG[SRC_HEURISTIC]}" ;;
        esac
        printf '%s\t%s[%s]\033[0m %-6s %s  \033[90m%s · %s\033[0m\n' \
            "$(jq -r '.path' <<< "$line")" "$color" "$label" "$(human_size "$(jq -r '.bytes' <<< "$line")")" \
            "$(jq -r '.path' <<< "$line" | sed "s#^$HOME#~#")" "$src_label" "$(jq -r '.reason' <<< "$line")"
    done < "$FINAL_FILE")
    local bind="start:first"
    [[ -z "$preselect" ]] || bind="start:${preselect#+}+first"
    printf '%s\n' "$rows" | fzf --multi --ansi --delimiter='\t' --with-nth=2.. \
        --height=70% --layout=reverse --border --tiebreak=index \
        --header "${MSG[PICK_HEADER]}" --prompt "${MSG[PICK_PROMPT]}" \
        --bind "$bind" \
        --preview 'p=$(printf "%s" {1}); if [ -d "$p" ]; then ls -la --color=always "$p" | head -60; else file "$p"; head -c 2000 "$p"; fi' \
        --preview-window=down:45%:wrap \
        | cut -f1 > "$PICK_FILE" || true
}

trash_backend() {
    if [[ "$USE_RM" == true ]]; then printf 'rm'
    elif command -v gio >/dev/null 2>&1; then printf 'gio'
    elif command -v trash-put >/dev/null 2>&1; then printf 'trash-put'
    else printf 'xdg'; fi
}

trash_manual() {
    # 手写 FreeDesktop Trash 规范：~/.local/share/Trash/files + info/*.trashinfo
    local path="$1" trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash" name target i=0
    mkdir -p "$trash/files" "$trash/info"
    name=$(basename "$path")
    target="$trash/files/$name"
    while [[ -e "$target" || -e "$trash/info/$(basename "$target").trashinfo" ]]; do
        i=$((i + 1)); target="$trash/files/${name}.${i}"
    done
    printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' "$(printf '%s' "$path" | jq -Rr '@uri' | sed 's#%2F#/#g')" "$(date +%Y-%m-%dT%H:%M:%S)" \
        > "$trash/info/$(basename "$target").trashinfo"
    mv -- "$path" "$target"
}

trash_path() {
    local path="$1"
    case "$(trash_backend)" in
        rm) rm -rf -- "$path" ;;
        gio) gio trash -- "$path" ;;
        trash-put) trash-put -- "$path" ;;
        xdg) trash_manual "$path" ;;
    esac
}

process_leftovers() {
    # process_leftovers：对 $PICK_FILE 里的路径逐个入回收站；再次校验边界
    local path ok=0 fail=0 backend
    backend=$(trash_backend)
    local shown
    echo -e "\n\033[36m${MSG[TRASHING]}\033[0m \033[90m(${MSG[TRASH_BACKEND]} ${backend})\033[0m"
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        shown="${path/#$HOME/\~}"
        if [[ ! -e "$path" || -L "$path" ]] || is_denied "$path"; then
            echo -e "   \033[31m${MSG[TRASH_FAILED]}\033[0m $shown"; fail=$((fail + 1)); continue
        fi
        if trash_path "$path"; then
            if [[ "$backend" == rm ]]; then echo -e "   \033[33m${MSG[DELETED]}\033[0m $shown"; else echo -e "   \033[32m${MSG[TRASHED]}\033[0m $shown"; fi
            ok=$((ok + 1))
        else
            echo -e "   \033[31m${MSG[TRASH_FAILED]}\033[0m $shown"; fail=$((fail + 1))
        fi
    done < "$PICK_FILE"
    echo
    if (( fail > 0 )); then
        printf "\033[33m${MSG[DONE]}\033[0m (%s failed)\n" "$ok" "$fail"
    else
        printf "\033[36m${MSG[DONE]}\033[0m\n" "$ok"
    fi
}

leftover_scan() {
    # leftover_scan：主流程。输入 PAC_PKGS / FPK_PKGS；输出 PICK_FILE（选中的路径）
    PKG_META_FILE="${TMP_DIR}/packages.ndjson"
    CAND_FILE="${TMP_DIR}/candidates.ndjson"
    SEEN_FILE="${TMP_DIR}/seen"
    FINAL_FILE="${TMP_DIR}/final.ndjson"
    PICK_FILE="${TMP_DIR}/picked"
    DOSSIER="${TMP_DIR}/leftover.dossier"
    RESULT="${TMP_DIR}/leftover.json"
    : > "$PKG_META_FILE"; : > "$CAND_FILE"; : > "$SEEN_FILE"; : > "$PICK_FILE"
    TOKENS=()
    HEURISTIC_FALLBACK=false

    echo -e "\n\033[36m${MSG[COLLECTING]}\033[0m"
    local p
    for p in "${PAC_PKGS[@]}"; do collect_pacman_meta "$p"; done
    for p in "${FPK_PKGS[@]}"; do collect_flatpak_meta "$p"; done
    echo -e "   \033[90m${MSG[TOKENS]} ${TOKENS[*]:-}\033[0m"
    enumerate_candidates
    # Flatpak 的数据目录是确定的，直接补进候选
    for p in "${FPK_PKGS[@]}"; do emit_candidate "$HOME/.var/app/$p" ".var/app" "$p"; done
    if [[ -s "$CAND_FILE" ]]; then score_candidates; fi
    printf "   \033[90m${MSG[CANDIDATES]}\033[0m\n" "$(grep -c . "$CAND_FILE" || true)"
    echo

    if [[ "$AI_LOADED" == true ]]; then
        jq -n --arg home "$HOME" \
            --slurpfile pkgs "$PKG_META_FILE" \
            --slurpfile cands "$CAND_FILE" \
            '{schema:"shorin_pac_leftover_evidence_v1", home:$home, packages:$pkgs, candidates:$cands}' > "$DOSSIER"
        if ! run_leftover_ai "$DOSSIER" "$RESULT"; then
            echo -e "\033[33m${MSG[AI_FAILED]}\033[0m" >&2
            HEURISTIC_FALLBACK=true
            : > "$RESULT"
        fi
    else
        HEURISTIC_FALLBACK=true
        : > "$RESULT"
    fi

    build_final_list "$RESULT"
    if [[ -s "$RESULT" ]]; then
        local notes
        notes=$(jq -r '.notes[]? | select(type == "string" and length > 0) | "  - " + .' "$RESULT" 2>/dev/null || true)
        if [[ -n "$notes" ]]; then
            echo -e "\n\033[36m${MSG[AI_NOTES]}\033[0m"
            printf '%s\n' "$notes" | sed 's/^  - /   - /'
        fi
    fi
    if [[ ! -s "$FINAL_FILE" ]]; then
        echo -e "\n\033[32m${MSG[NO_CANDIDATES]}\033[0m"
        return 0
    fi
    pick_leftovers
    if [[ ! -s "$PICK_FILE" ]]; then
        echo -e "\n\033[33m${MSG[PICK_NONE]}\033[0m"
        return 0
    fi
    echo
    if [[ "$USE_RM" == true ]]; then
        printf "\033[33m${MSG[PICKED_RM]}\033[0m\n" "$(grep -c . "$PICK_FILE")"
    else
        printf "\033[36m${MSG[PICKED]}\033[0m\n" "$(grep -c . "$PICK_FILE")"
    fi
    sed "s#^$HOME#~#; s/^/   /" "$PICK_FILE"
}

# --- 7. 交互式 FZF 渲染与智能预览 ---
PREVIEW_CMD="
line={}
if [[ \"\$line\" == PKG:* ]]; then
    pkg=\$(echo \"\$line\" | awk '{print \$3}')
    ${AUR_HELPER} -Qi \"\$pkg\"
elif [[ \"\$line\" == FLTK:* ]]; then
    appid=\$(echo \"\$line\" | awk '{print \$NF}')
    flatpak info \"\$appid\"
fi
"

COLOR_YELLOW=$'\033[33m'
COLOR_CYAN=$'\033[36m'
COLOR_RESET=$'\033[0m'
FZF_HEADER="${MSG[HEADER]} | ${COLOR_YELLOW}${AUR_HELPER}${COLOR_RESET}"
if [ "$HAS_FLATPAK" = true ]; then
    FZF_HEADER+=" & ${COLOR_CYAN}Flatpak${COLOR_RESET}"
fi

set +e
fzf --multi --ansi \
    --preview "$PREVIEW_CMD" \
    --preview-window=down:55%:wrap \
    --height=95% --layout=reverse --border \
    --bind "alt-j:last,alt-k:first" \
    --bind "ctrl-r:reload(\"$SCRIPT_PATH\" --generate-data)" \
    --bind "alt-c:execute-silent(touch \"$CLEAN_FLAG\")+accept" \
    --tiebreak=index \
    --with-nth=2.. \
    --header "$FZF_HEADER" \
    --query "${QUERY_ARGS[*]:-}" \
    < <("$SCRIPT_PATH" --generate-data) \
    > "$TARGET_FILE"
FZF_EXIT=$?
set -e

[[ $FZF_EXIT -eq 0 && -s "$TARGET_FILE" ]] || exit 0
[[ ! -e "$CLEAN_FLAG" ]] || CLEAN_MODE="yes"

# --- 8. 拆分选中的项目 ---
mapfile -t SELECTED_LINES < "$TARGET_FILE"
PAC_PKGS=()
FPK_PKGS=()
for line in "${SELECTED_LINES[@]}"; do
    if [[ "$line" == PKG:* ]]; then
        pkg=$(echo "$line" | awk '{print $3}')
        [[ -n "$pkg" ]] && PAC_PKGS+=("$pkg")
    elif [[ "$line" == FLTK:* ]]; then
        appid=$(echo "$line" | awk '{print $NF}')
        [[ -n "$appid" ]] && FPK_PKGS+=("$appid")
    fi
done
[[ ${#PAC_PKGS[@]} -gt 0 || ${#FPK_PKGS[@]} -gt 0 ]] || exit 0
ALL_NAMES="${PAC_PKGS[*]:-} ${FPK_PKGS[*]:-}"

# --- 9. 残留检测（卸载之前） ---
AI_LOADED=false
DO_CLEAN=false
if [[ "$CLEAN_MODE" != "no" ]]; then
    load_ai_lib || true
    if [[ "$CLEAN_MODE" == "yes" ]]; then
        DO_CLEAN=true
        [[ "$AI_LOADED" == true ]] || echo -e "\033[33m${MSG[AI_UNAVAILABLE]}\033[0m" >&2
    else
        while true; do
            echo -e "\n\033[35m╭─ ${MSG[CLEAN_ASK_TITLE]}\033[0m"
            printf "\033[35m│\033[0m ${MSG[CLEAN_ASK_BODY]}\n" "${ALL_NAMES# }"
            echo -e "\033[35m│\033[0m \033[90m${MSG[CLEAN_ASK_HINT]}\033[0m"
            if [[ "$AI_LOADED" == true ]]; then
                printf "\033[35m│\033[0m \033[90m${MSG[CLEAN_ASK_MODEL]}\033[0m\n" "$(ai_describe_selection)"
            else
                echo -e "\033[35m│\033[0m \033[33m${MSG[AI_UNAVAILABLE]}\033[0m"
            fi
            printf "\033[35m╰─\033[0m ${MSG[CLEAN_ASK_PROMPT]}"
            read -r answer || answer="n"
            case "${answer:-Y}" in
                y|Y|yes|YES) DO_CLEAN=true; break ;;
                m|M) if [[ "$AI_LOADED" == true ]]; then ai_select_interactive || true; AI_SPEC=""; AI_MODEL_OVERRIDE=""; fi ;;
                *) break ;;
            esac
        done
    fi
fi

if [[ "$DO_CLEAN" == true ]]; then
    leftover_scan
fi

if [[ "$SCAN_ONLY" == true ]]; then
    echo -e "\n\033[36m${MSG[SCAN_DONE]}\033[0m"
    exit 0
fi

# --- 10. 确认并执行卸载 ---
if [[ "$DO_CLEAN" == true ]]; then
    printf "\n${MSG[CONFIRM_REMOVE]}"
    read -r answer || answer="n"
    case "${answer:-Y}" in
        y|Y|yes|YES) ;;
        *) echo "${MSG[CANCELLED]}"; exit 0 ;;
    esac
fi

REMOVE_OK=true
if [[ ${#PAC_PKGS[@]} -gt 0 ]]; then
    echo -e "\n\033[34m${MSG[REMOVING_PAC]}\033[0m"
    echo "${PAC_PKGS[*]}"
    echo "----------------------------------------"
    LC_ALL="$ORIGINAL_LANG" "$AUR_HELPER" -Rns "${PAC_PKGS[@]}" || REMOVE_OK=false
fi
if [[ ${#FPK_PKGS[@]} -gt 0 ]]; then
    echo -e "\n\033[36m${MSG[REMOVING_FPK]}\033[0m"
    echo "${FPK_PKGS[*]}"
    echo "----------------------------------------"
    LC_ALL="$ORIGINAL_LANG" flatpak uninstall "${FPK_PKGS[@]}" || REMOVE_OK=false
fi

# --- 11. 卸载成功后处理残留 ---
if [[ "$DO_CLEAN" == true && -s "${PICK_FILE:-/dev/null}" ]]; then
    if [[ "$REMOVE_OK" == true ]]; then
        process_leftovers
    else
        echo -e "\033[33m${MSG[REMOVE_FAILED]}\033[0m" >&2
        exit 1
    fi
fi
[[ "$REMOVE_OK" == true ]] || exit 1
