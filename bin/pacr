    MSG[ERR_HELPER]="错误：未找到 paru 或 yay，请至少安装其中一个作为 AUR 助手。"
    MSG[REMOVING_PAC]=">> 准备卸载 (Pacman/AUR)："
    MSG[REMOVING_FPK]=">> 准备卸载 (Flatpak)："
    MSG[HEADER]="Tab:多选 | Enter:卸载 | Alt+C:卸载并清残留 | Ctrl+R:刷新 | Esc:退出"
    MSG[CLEAN_ASK_TITLE]="AI 残留检测"
    MSG[CLEAN_ASK_BODY]="将卸载：%s"
    MSG[CLEAN_ASK_HINT]="检测家目录中属于这些软件的配置/缓存/数据，勾选后在卸载成功后移入回收站；输入 m 更换 AI。"
    MSG[CLEAN_ASK_MODEL]="当前 AI：%s"
    MSG[CLEAN_ASK_PROMPT]="是否使用 AI 检测卸载残留? [Y/n/m] "
