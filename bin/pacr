    MSG[OPT_CLEAN]="  --clean         Detect leftovers with AI before removal (no prompt)"
    MSG[OPT_NO_CLEAN]="  --no-clean      Skip leftover detection (no prompt)"
    MSG[OPT_SCAN]="  --scan          Only detect and list leftovers; do not remove or delete anything"
    MSG[OPT_RM]="  --rm            Delete leftovers directly instead of moving them to the trash"
    MSG[OPT_AI]="  --ai <provider[:model]>  Use this AI provider/model for this run"
    MSG[OPT_AI_MODEL]="  --ai-model <model>       Only switch the model of the current provider"
    MSG[FEAT]="Features:"
    MSG[FEAT_1]="- Unified UI: Mix, multi-select and remove Native & Flatpak apps together"
    MSG[FEAT_2]="- Safe & Clean: Pacman recursive remove (-Rns), Flatpak native protection"
    MSG[FEAT_3]="- Leftover cleanup: AI spots config/cache/data leftovers in HOME; selected ones go to the trash after removal"
    MSG[FEAT_4]="- Visuals: Blue(Repo) | Purple(AUR) | Cyan(Flatpak)"
    MSG[EX]="Example:"
    MSG[ERR_FZF]="Error: fzf not found."
    MSG[ERR_HELPER]="Error: Neither paru nor yay found. Please install an AUR helper."
    MSG[REMOVING_PAC]=">> Preparing to remove (Pacman/AUR):"
